+void InputManager::updateLadderConfirmBackHold(const unsigned long currentTime) {
+  const uint8_t sampled = getState();
+  if (sampled != ladderSampleState) {
+    ladderSampleState = sampled;
+    lastDebounceTime = currentTime;
+  }
+  // The ladder's RC edge sweeps through the LEFT/RIGHT windows on its way to
+  // CONFIRM (0 mV); only act on a sample that has been stable for DEBOUNCE_DELAY.
+  if (currentTime - lastDebounceTime <= DEBOUNCE_DELAY) return;
+
+  const bool pressed = ladderSampleState & (1 << BTN_CONFIRM);
+  const uint8_t nonSharedState = ladderSampleState & ~(1 << BTN_CONFIRM);
+  bool emitConfirmClick = false;
+
+  if (pressed && !confirmBackPhysicalPressed) {
+    confirmBackPhysicalPressed = true;
+    confirmBackLongPressActive = false;
+    confirmBackPressStart = currentTime;
+  }
+
+  uint8_t nextState = nonSharedState;
+  if (pressed && currentTime - confirmBackPressStart >= CONFIRM_BACK_HOLD_MS) {
+    confirmBackLongPressActive = true;
+    nextState |= (1 << BTN_BACK);
+  }
+
+  if (!pressed && confirmBackPhysicalPressed) {
+    confirmBackPhysicalPressed = false;
+    if (!confirmBackLongPressActive) {
+      emitConfirmClick = true;
+      buttonPressStart = confirmBackPressStart;
+      buttonPressFinish = currentTime;
+    }
+    confirmBackLongPressActive = false;
+  }
+
+  if (nextState != currentState) applyStateChange(nextState, currentTime);
+
+  if (emitConfirmClick) {
+    pressedEvents |= (1 << BTN_CONFIRM);
+    releasedEvents |= (1 << BTN_CONFIRM);
+  }
+}
