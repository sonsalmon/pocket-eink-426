diff --git a/platformio.ini b/platformio.ini
index e6b5d0f..32191e0 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -264,6 +264,18 @@ build_flags =
   ; serial output is disabled in slim builds to save space
   -UENABLE_SERIAL_LOG
 
+; --- Pocket E-Ink 4.26 — ESP32-C3 + 16 MB flash, GDEY0426T82 (SSD1677 800x480) ----
+; Custom board from github.com/sonsalmon/pocket-eink-426 (X4 pinout, 3-key ladder).
+;   pio run -e pocket426 -t upload
+[env:pocket426]
+extends = base, firmware_tuned_c3
+build_flags =
+  ${base.build_flags}
+  -DFREEINK_DEVICE_POCKET426=1
+  -DCROSSPOINT_VERSION=\"${crosspoint.version}-pocket426\"
+  -DENABLE_SERIAL_LOG
+  -DLOG_LEVEL=1
+
 ; --- Seeed Sticky — ESP32-S3R8, 3.97" 800x480 SSD1677 + GT911 touch -----------
 ; Different MCU family than the C3 envs (one binary per family). The SDK
 ; auto-enables CAP_TOUCH (GT911) and the BQ27220 gauge for this device. The
